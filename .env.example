# Public client configuration. Vite inlines every VITE_ variable into the browser bundle.
# These three are public by design. Do not put secrets in VITE_ variables.
# The anon key is safe to ship only because Row Level Security limits what it can read.
# Never commit real values. Copy this file to .env (gitignored) for local development.

VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe publishable key only (Dashboard → API keys). Not the secret key.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Server-only secrets. Set these in the Supabase Edge Function environment, never in Vite:
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_PREMIUM_PRICE_ID
# TAVUS_API_KEY
# ELEVEN_LABS_API_KEY
